# Copy to .env and adjust. Every variable is documented in docker-compose.yml.

# Database password for the bundled postgres service.
POSTGRES_PASSWORD=oxybook-dev

# Signing key for sessions and one-time codes, and the key the stored GitHub App secrets
# are encrypted with. Generate with: openssl rand -hex 32. Do not change it after the App
# is created: the server will refuse to start until the github_app row is removed.
OXYBOOK_SECRET_KEY=

# Where the editor is reachable, and the suffix for platform-hosted sites.
OXYBOOK_PUBLIC_URL=http://app.localhost:8080
OXYBOOK_SITES_DOMAIN=docs.localhost

# GitHub App. Leave empty to create one from the setup screen (App Manifest flow).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Read by `pnpm oxybook-dev propose` only, when --installation-id is not passed.
GITHUB_APP_INSTALLATION_ID=

# Optional webhook relay for local development (docker compose --profile webhooks up).
SMEE_URL=

# SMTP. Defaults to the bundled mailpit in dev.
SMTP_URL=smtp://mailpit:1025
SMTP_FROM=

# Override once a real image exists.
# OXYBOOK_IMAGE=
