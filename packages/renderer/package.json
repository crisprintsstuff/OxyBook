{
  "name": "@oxybook/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Markdown and MDX renderer for OxyBook: mdast to hast, allowlisted components, Shiki, link rewriting, zero code evaluation.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @oxybook/db --filter @oxybook/doc-model --filter @oxybook/sync --filter @oxybook/theme-default build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @oxybook/db --filter @oxybook/doc-model --filter @oxybook/sync --filter @oxybook/theme-default build && node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:corpus": "pnpm --filter @oxybook/db --filter @oxybook/doc-model --filter @oxybook/sync --filter @oxybook/theme-default build && node --import tsx --test test/corpus.render.ts"
  },
  "dependencies": {
    "@oxybook/db": "workspace:*",
    "@oxybook/doc-model": "workspace:*",
    "@oxybook/sync": "workspace:*",
    "@oxybook/theme-default": "workspace:*",
    "hast-util-to-html": "9.0.6",
    "mdast-util-to-hast": "13.2.1",
    "pagefind": "1.5.2",
    "shiki": "4.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
