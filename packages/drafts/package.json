{
  "name": "@oxybook/drafts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Drafts: per-user unproposed changes with If-Match concurrency, diff preview, and 3-way rebase when the base moves.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @oxybook/db --filter @oxybook/github --filter @oxybook/git-write build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @oxybook/db --filter @oxybook/github --filter @oxybook/git-write build && node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@oxybook/db": "workspace:*",
    "@oxybook/git-write": "workspace:*",
    "diff": "9.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
