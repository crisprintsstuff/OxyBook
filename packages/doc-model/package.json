{
  "name": "@oxybook/doc-model",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Lossless markdown and MDX round-trip for OxyBook.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:corpus": "node --import tsx --test test/corpus.harness.ts",
    "compat:corpus": "tsx test/corpus.compat.ts"
  },
  "dependencies": {
    "mdast-util-directive": "3.1.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.2.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
