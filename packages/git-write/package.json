{
  "name": "@oxybook/git-write",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Build a commit from a blobless mirror, push it to an oxybook/* ref, and open a GitHub pull request.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @oxybook/github build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @oxybook/github build && node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@oxybook/github": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
