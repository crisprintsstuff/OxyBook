{
  "name": "@oxybook/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "OxyBook editor SPA: React, a ProseMirror visual editor on the doc-model bridge, and CodeMirror 6 source mode. Served by apps/server at /orgs/:org/spaces/:space/edit; talks to /api/editor.",
  "scripts": {
    "build": "pnpm --filter @oxybook/doc-model build > /dev/null && vite build",
    "dev:watch": "vite build --watch",
    "typecheck": "pnpm --filter @oxybook/doc-model build > /dev/null && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @oxybook/doc-model build > /dev/null && node --import tsx --test test/*.test.ts",
    "test:corpus": "pnpm --filter @oxybook/doc-model build > /dev/null && node --import tsx --test test/corpus.visual.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@oxybook/doc-model": "workspace:*",
    "codemirror": "6.0.2",
    "prosemirror-commands": "1.7.2",
    "prosemirror-dropcursor": "1.8.4",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
