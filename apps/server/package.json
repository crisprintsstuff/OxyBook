{
  "name": "@oxybook/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "OxyBook API process. M0 exposes /healthz, the GitHub manifest callback, and webhook verification, and runs database migrations on start when asked.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @oxybook/github --filter @oxybook/db --filter @oxybook/jobs build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @oxybook/github --filter @oxybook/db --filter @oxybook/jobs build && node --import tsx --test test/*.test.ts",
    "dev": "pnpm --filter @oxybook/github --filter @oxybook/db --filter @oxybook/jobs build && tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@oxybook/db": "workspace:*",
    "@oxybook/github": "workspace:*",
    "@oxybook/jobs": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
