{
  "name": "@oxybook/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "OxyBook worker process. Serves /healthz and works jobs from the PostgreSQL queue.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @oxybook/github --filter @oxybook/db --filter @oxybook/doc-model --filter @oxybook/jobs --filter @oxybook/sync build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @oxybook/github --filter @oxybook/db --filter @oxybook/doc-model --filter @oxybook/jobs --filter @oxybook/sync build && node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "dev": "pnpm --filter @oxybook/github --filter @oxybook/db --filter @oxybook/doc-model --filter @oxybook/jobs --filter @oxybook/sync build && tsx watch src/main.ts",
    "dev:watch": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@oxybook/db": "workspace:*",
    "@oxybook/jobs": "workspace:*",
    "@oxybook/sync": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
